{
  "name": "wedding-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "description": "Android application for couple workflows in the wedding management system.",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "audit:ci": "npm run test:audit-policy && node scripts/audit-ci.mjs",
    "build": "expo export --platform android --output-dir dist",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:audit-policy": "node --test scripts/audit-ci.test.mjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.27.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  }
}
