{
  "name": "wedding-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "description": "Android application for couple workflows in the wedding management system.",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "audit:ci": "npm run test:audit-policy && node scripts/audit-ci.mjs",
    "build": "expo export --platform android --output-dir dist",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:audit-policy": "node --test scripts/audit-ci.test.mjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  }
}
